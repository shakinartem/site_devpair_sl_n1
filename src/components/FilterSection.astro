---
const yesItems = [
  'Вы предприниматель, руководитель или эксперт 30+. Деньги есть, статус есть, а внутренний ресурс почти исчерпан.',
  'Вы построили систему, но она давно управляет вами сильнее, чем вы ею.',
  'При внешнем успехе тело начинает сдавать: сон, энергия, желание, вкус к жизни.',
  'Внутри не пусто, а слишком тихо. И эта тишина уже не кажется роскошью.',
  'Вы давно не слышите себя за задачами, результатами и чужими ожиданиями.',
  'Вы устали, но не позволяете себе остановиться без причины, формы и разрешения.'
];

const noItems = [
  'Вы ищете бодрый старт, заряд мотивации и обещание, что все будет легко и быстро.',
  'Вам нужен список действий вместо честного разговора о том, что больше не работает.',
  'Вы хотите результат без паузы, без пересборки и без встречи с собой.',
  'Вам важно, чтобы специалист просто подтвердил, что вы и так все делаете правильно.'
];
---

<section class="section" id="filter">
  <div class="site-shell">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Квалификация</p>
      <h2>Это про вас, или нет</h2>
      <p class="section-description">
        Мягкий фильтр, который сразу экономит время: здесь ценят глубину, а не декоративную активность.
        Если вы узнаете себя, значит мы говорим на одном языке.
      </p>
    </div>

    <div class="section-grid-2">
      <article class="luxury-card filter-card filter-card--warm" data-reveal>
        <span class="label-chip">Это для вас</span>
        <h3 class="luxury-card__title">Если снаружи все собрано, но внутри стало слишком тихо</h3>
        <div class="filter-grid">
          {yesItems.map((item) => <p>{item}</p>)}
        </div>
      </article>

      <article class="luxury-card filter-card filter-card--neutral" data-reveal>
        <span class="label-chip">Это не для вас</span>
        <h3 class="luxury-card__title">Если вы пришли за быстрым вдохновением</h3>
        <div class="filter-grid">
          {noItems.map((item) => <p>{item}</p>)}
        </div>
      </article>
    </div>
  </div>
</section>
