---
import entryStageImage from '../../assets/photo_2026-04-30_17-29-19.jpg';
import { publicImage } from '../lib/paths';

const telegramUrl = import.meta.env.PUBLIC_TELEGRAM_URL ?? 'https://t.me/';

const products = [
  {
    title: 'Интенсив «Настройка»',
    eyebrow: 'Интенсив',
    price: '5 900 ₽',
    text: 'Для тех, кто понимает: снаружи всё работает, но внутри что-то звучит не так. За встречу мы находим точку входа, снимаем лишний шум и определяем, с чего действительно стоит начинать.',
    bullets: ['Комфортное знакомство', 'Диагностика состояния', 'Карта следующего шага'],
    action: 'Записаться',
    image: entryStageImage.src,
    imageAlt: 'Светлана у сцены и рояля',
    mediaClass: 'product-media--portrait'
  },
  {
    title: 'Клуб «Симфония»',
    eyebrow: 'Клуб',
    price: '9 900 ₽',
    text: 'Для ясного запроса и глубокой работы в одной встрече. Это формат, где можно быстро увидеть, где застряло решение, и аккуратно развернуть его в сторону движения.',
    bullets: ['Индивидуальные инструменты', 'Разбор сопротивлений', 'Практическая ясность'],
    action: 'Выбрать формат',
    image: publicImage('elegance-close.jpg'),
    imageAlt: 'Чёрно-белый портрет Светланы'
  },
  {
    title: 'Менторство «Архитектура»',
    eyebrow: 'Флагман',
    price: '95 000 ₽',
    text: 'Формат для тех, кто чувствует: проблема не в одном запросе. Вся конструкция жизни требует пересборки. Четыре глубокие встречи и поддержка между ними создают новую внутреннюю опору.',
    bullets: ['4 сессии по 60 минут', 'Поддержка в мессенджере', 'Новая система движения'],
    action: 'Записаться на диагностику',
    featured: true,
    image: publicImage('group-photo.jpg'),
    imageAlt: 'Светлана с участниками группы'
  }
];
---

<section class="section section--products" id="products" data-tone="sand">
  <div class="site-shell">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Форматы</p>
      <h2>Три точки входа для разного уровня готовности</h2>
      <p class="section-description">
        Спокойная лестница выбора: от первой встречи до глубокой перестройки жизни. Самый сильный формат выделен
        визуально и смыслово.
      </p>
    </div>

    <div class="products-layout">
      <div class="products-grid" data-reveal>
        {products.map((product) => (
          <article class:list={['product-card', product.featured ? 'product-card--featured' : '']}>
            <span class="label-chip">{product.eyebrow}</span>
            <h3>{product.title}</h3>
            <div class="product-price">{product.price}</div>
            <p>{product.text}</p>
            <ul class="luxury-list">
              {product.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
            <div class="cta-row">
              <a class={product.featured ? 'button button--solid' : 'button button--ghost'} href="#contact">
                {product.action}
              </a>
              <a class="button button--ghost" href={telegramUrl} target="_blank" rel="noreferrer">
                Telegram
              </a>
            </div>
            <div class:list={['product-media', product.mediaClass]}>
              <img src={product.image} alt={product.imageAlt ?? product.title} loading="lazy" decoding="async" />
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
