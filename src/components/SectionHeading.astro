---
const { eyebrow, title, description, centered = false } = Astro.props as {
  eyebrow: string;
  title: string;
  description?: string;
  centered?: boolean;
};
---

<div class:list={['section-heading', centered ? 'center' : '']} data-reveal>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p class="section-description">{description}</p>}
</div>
