---
import { publicImage } from '../lib/paths';
---

<section class="hero section section--hero" id="home" data-tone="light">
  <div class="hero-backdrop" aria-hidden="true">
    <div class="hero-backdrop__grid"></div>
    <div class="hero-backdrop__halo"></div>
  </div>

  <div class="site-shell hero__grid" data-animate="hero">
    <div class="hero-copy">
      <p class="eyebrow hero-kicker" data-animate-item>Executive coaching · burnout recovery · life architecture</p>
      <h1 class="hero-title" data-animate-item>
        <span class="hero-line">Светлана Лагутова -</span>
        <span class="hero-line">архитектор жизни для</span>
        <span class="hero-line">предпринимателей,</span>
        <span class="hero-line">топ-менеджеров и управляющих,</span>
        <span class="hero-line">которым нужен не шум,</span>
        <span class="hero-line">а новая внутренняя опора</span>
      </h1>
      <p class="hero-subtitle" data-animate-item>
        Светлана Лагутова помогает предпринимателям, руководителям и экспертам вернуть ясность, тон и достоинство.
        Это не мотивация и не шумный инфобизнес. Это private-level executive coaching, где внешняя собранность снова
        совпадает с внутренней опорой.
      </p>

      <div class="hero-support" data-animate-item>
        <figure class="hero-mini-card">
          <img
            src={publicImage('lavender-balcony.jpg')}
            alt="Светлана на балконе"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Quiet presence, close to the text</figcaption>
        </figure>
        <figure class="hero-mini-card hero-mini-card--soft">
          <img
            src={publicImage('group-photo.jpg')}
            alt="Групповое фото Светланы с коллегами"
            loading="lazy"
            decoding="async"
          />
          <figcaption>Работа с предпринимателями и руководителями</figcaption>
        </figure>
      </div>

      <div class="cta-row" data-animate-item>
        <a class="button button--solid" href="#contact">Записаться на диагностику</a>
        <a class="button button--ghost" href="#products">Посмотреть форматы</a>
      </div>

      <div class="hero-meta" data-animate-item>
        <div class="hero-meta__item">
          <strong>3-4 клиента</strong>
          <span>Ограниченная вместимость для глубокой, точной и спокойной работы.</span>
        </div>
        <div class="hero-meta__item">
          <strong>Online worldwide</strong>
          <span>Zoom, Telegram и любой удобный для вас формат связи.</span>
        </div>
        <div class="hero-meta__item">
          <strong>Luxury funnel</strong>
          <span>Мягкая конверсия без давления, спама и дешёвого маркетинга.</span>
        </div>
      </div>
    </div>

    <div class="hero-visual" data-reveal data-parallax>
      <div class="hero-frame hero-frame--hero">
        <img
          src={publicImage('hero-main-bw.jpg')}
          alt="Светлана Лагутова в черно-белом образе"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-strip" aria-hidden="true">
        <div class="hero-strip__image">
          <img src={publicImage('elegance-close.jpg')} alt="" loading="lazy" decoding="async" />
        </div>
        <div class="hero-strip__image">
          <img src={publicImage('chandelier.jpg')} alt="" loading="lazy" decoding="async" />
        </div>
      </div>
      <div class="hero-badge">Cinematic elegance · calm authority</div>
      <div class="hero-signal">
        <span class="hero-signal__dot"></span>
        <span>By appointment only</span>
      </div>
    </div>
  </div>
</section>
