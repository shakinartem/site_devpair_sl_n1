---
import { publicImage } from '../lib/paths';

const steps = [
  {
    title: 'Целостность',
    text: 'Тело, психика и бизнес-логика не три разные проблемы, а одна система, которая должна начать звучать согласованно.'
  },
  {
    title: 'Тело первым',
    text: 'Голова умеет рационализировать. Тело нет. Поэтому мы начинаем с того, что сложнее всего подделать.'
  },
  {
    title: 'Настройка, не ремонт',
    text: 'Вы не сломаны. Вы расстроены. Моя задача помочь найти точное звучание, а не вернуть вас в прежний перегрев.'
  },
  {
    title: 'Разговор на равных',
    text: 'Без жалости, без давления и без патетики. С уважением, ясностью и точностью, которые ценят сильные люди.'
  }
];
---

<section class="section section--method" id="method" data-tone="light">
  <div class="site-shell">
    <div class="method-grid">
      <div class="method-copy">
        <div class="section-heading" data-reveal>
          <h2>Четыре принципа, которые отличают мою работу</h2>
          <p class="section-description">
            В основе executive coaching, внимание к телу и архитектурное мышление. Метод не обещает чудес. Он возвращает
            форму, в которой снова появляются и сила, и вкус к жизни.
          </p>
        </div>

        <div class="method-steps">
          {steps.map((step, index) => (
            <article class="method-step" data-step={index + 1} data-reveal>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </article>
          ))}
        </div>
      </div>

      <div class="method-visual" data-reveal>
        <div class="hero-frame hero-frame--portrait">
          <img
            src={publicImage('method-detail.jpg')}
            alt="Эмоциональный портрет Светланы"
            loading="lazy"
            decoding="async"
            data-parallax
          />
        </div>
        <div class="method-sidecard">
          <div class="method-sidecard__item">
            <span class="method-sidecard__label">Формат контакта</span>
            <strong>Глубоко, спокойно, без давления</strong>
          </div>
          <div class="method-sidecard__item">
            <span class="method-sidecard__label">Результат</span>
            <strong>Меньше шума, больше внутренней формы</strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
