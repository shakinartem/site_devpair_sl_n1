---
const telegramUrl = import.meta.env.PUBLIC_TELEGRAM_URL ?? 'https://t.me/';
const instagramUrl = import.meta.env.PUBLIC_INSTAGRAM_URL ?? 'https://instagram.com/';
---

<footer class="site-footer">
  <div class="site-shell site-footer__inner">
    <div class="site-footer__row">
      <div class="brand-mark">
        <strong>Светлана Лагутова</strong>
        <span>quiet luxury personal brand</span>
      </div>
      <div class="footer-links">
        <a href={telegramUrl} target="_blank" rel="noreferrer">Telegram</a>
        <a href={instagramUrl} target="_blank" rel="noreferrer">Instagram</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/public-offer">Public Offer</a>
        <a href="/consent">Consent</a>
      </div>
    </div>
    <div class="site-footer__row">
      <p>© Светлана Лагутова, 2025</p>
      <p>Деятельность не является медицинской и психотерапевтической практикой.</p>
    </div>
    <div class="site-footer__row">
      <p>Created by DevPair — <a href="https://devpair.ru/" target="_blank" rel="noreferrer">devpair.ru</a></p>
      <p>Архитектура, дизайн и SEO собраны как private-level life architecture funnel.</p>
    </div>
  </div>
</footer>
