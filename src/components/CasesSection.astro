---
import { publicImage } from '../lib/paths';

const cases = [
  {
    title: 'Предприниматель, 41 год',
    context: 'Собственный бизнес, команда, внешне выстроенная система.',
    text: 'Запрос звучал просто: снова захотеть просыпаться утром. Мы начали с тела, потому что оно не умеет притворяться. Оказалось, он три года не спал нормально не из-за слабости, а потому что остановиться было страшнее, чем выгорать.',
    outcome: 'Через три месяца появилась не только энергия, но и новое ощущение смысла: жить, а не только справляться.'
  },
  {
    title: 'Топ-эксперт, 38 лет',
    context: 'Сильный личный бренд, хороший доход, публичная фигура.',
    text: 'Она пришла с запросом на систему, чтобы меньше уставать. Но усталость оказалась не от нагрузки, а от одиночества внутри собственного успеха. Сначала стало возможно назвать это вслух, а уже потом пересобирать режим и опору.',
    outcome: 'Мы работали не только с системой, но и с тем, что стояло за ней.'
  },
  {
    title: 'Управляющий партнёр, 45 лет',
    context: 'Скептический запрос, без особой веры в коучинг.',
    text: 'Он думал, что устал от работы. В ходе сопровождения стало ясно: он устал от человека, которым стал ради этой работы. Именно это открыло дверь к точной и очень взрослой перестройке.',
    outcome: 'Самое важное часто начинается там, где заканчиваются красивые объяснения.'
  }
];
---

<section class="section section--cases" id="cases" data-tone="charcoal">
  <div class="site-shell">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">Кейсы</p>
      <h2>Истории из практики</h2>
      <p class="section-description">
        Здесь нет сухих цифр ради впечатления. Есть реальные состояния, реальные переломные точки и реальная
        трансформация, которую человек чувствует изнутри.
      </p>
    </div>

    <div class="case-grid">
      <aside class="case-aside" data-reveal>
        <div class="case-gallery">
          <div class="case-image">
            <img
              src={publicImage('hall-main.jpg')}
              alt="Концертный зал с роялем"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="case-image">
            <img
              src={publicImage('chandelier.jpg')}
              alt="Люстра в концертном зале"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </aside>

      <div class="cases-list">
        {cases.map((item, index) => (
          <article class="case-card" data-reveal data-card-index={index}>
            <span class="label-chip">{item.context}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <p><strong>{item.outcome}</strong></p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>
