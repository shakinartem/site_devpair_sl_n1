---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FooterSection from '../components/FooterSection.astro';
---

<BaseLayout
  title="404 — Светлана Лагутова"
  description="Страница не найдена."
  noindex={true}
>
  <Nav />
  <main class="legal-page">
    <div class="site-shell legal-card">
      <p class="eyebrow">404</p>
      <h1 class="page-title">Perhaps this page was never meant to be found.</h1>
      <p>
        Вероятно, ссылка устарела или адрес был введен с ошибкой. Но главное пространство сайта
        остается доступным.
      </p>
      <div class="cta-row">
        <a class="button button--solid" href="/">На главную</a>
        <a class="button button--ghost" href="#contact">Написать</a>
      </div>
    </div>
  </main>
  <FooterSection />
</BaseLayout>
