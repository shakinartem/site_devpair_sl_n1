---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import FooterSection from '../components/FooterSection.astro';
import { sitePath } from '../lib/paths';
---

<BaseLayout title="Страница не найдена — Светлана Лагутова" description="Запрашиваемая страница не найдена." noindex={true}>
  <Nav />
  <main class="legal-page">
    <div class="site-shell legal-card">
      <p class="eyebrow">404</p>
      <h1 class="page-title">Страница не найдена</h1>
      <p>Похоже, ссылка устарела или адрес был введён с ошибкой. Вернитесь на главную и продолжите знакомство оттуда.</p>
      <div class="cta-row">
        <a class="button button--solid" href={sitePath()}>На главную</a>
      </div>
    </div>
  </main>
  <FooterSection />
</BaseLayout>
